#pragma code_page(65001)

#include <winver.h>

@STAPIK_APP_RC_ICON@

1 VERSIONINFO
 FILEVERSION @STAPIK_APP_RC_VERSION@
 PRODUCTVERSION @STAPIK_APP_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@STAPIK_APP_RC_MAINTAINER@"
            VALUE "FileDescription", "@STAPIK_APP_RC_DESCRIPTION@"
            VALUE "FileVersion", "@STAPIK_APP_VERSION@"
            VALUE "InternalName", "@STAPIK_APP_NAME@"
            VALUE "OriginalFilename", "@STAPIK_APP_NAME@.exe"
            VALUE "ProductName", "@STAPIK_APP_RC_DISPLAY_NAME@"
            VALUE "ProductVersion", "@STAPIK_APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
